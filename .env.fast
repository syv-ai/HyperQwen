MODEL=/app/models/Qwen3.8-27B-W4A16-AutoRound-ar
#PORT=1234
PORT=18021
# FAST profile: MAX prefill + generation speed; context secondary but we
# stretched it to 80k (user-verified, runs fine with the pinned pool).
# bf16 KV (CTX=fast) + FA2 + Triton split-KV
# verify; PREFILL_ATTN=int8 (int8-QK Triton prefill attention) APPLIES here --
# it is bf16-KV-only (falls through to FA2/FlashInfer under fp8), and its
# companion INT8_ACT=int8 (W4A8 Marlin) speeds the prefill GEMMs. SPEC_ATTN=1
# is the default on this branch (split-KV verify kernel).
CTX=fast
MAX_LEN=80000
SPEC=mtp
# acceptance at K=4 measured ~51% on server; user chose to lower depth to 3
# (fewer wasted drafts, still chained on the MTP head). Default at CTX=fast was 4.
DRAFT_TOKENS=5
PREFIX_CACHE=1
REQ_METRICS=1
INT8_ACT=int8
INT8_LAYERS=mlp|linear_attn|self_attn
PREFILL_ATTN=int8
MAX_SEQS=1
KV_MEM=6790963200
#VLLM_V2_CUDAGRAPH_MEM_MIB=800

#docker compose --profile single up -d --force-recreate

# model already prepared & verified; run the idempotent prepare/verify on each boot
PREPARE=1
VERIFY=1
VISION=0
TOOLS=1
GPU_UTIL=0.948
