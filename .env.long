MODEL=/app/models/Qwen3.8-27B-W4A16-AutoRound-ar
#PORT=1234
PORT=18020
# LONG profile (default): context 170k, max prefill at that context. The trusted
# 3090 number GPU_UTIL=0.948 is back ON now that VBox 3D is off and the card is
# compute-free: both 2026-09-14 crashes were VBox-driven (VBoxHeadless ~257-472MiB
# steal), NOT a 0.948 problem per se. With VBox off, full-pool real free at
# 170000/0.948 is expected ~0.5GiB (was 23-104MiB with VBox). If a VRAM thief ever
# returns, fall back to GPU_UTIL=0.93 + MAX_LEN=150000 (battery-proven).
CTX=long
MAX_LEN=170000
SPEC=mtp
PREFIX_CACHE=1
REQ_METRICS=1
# Prefill (context processing) speed: W4A8 Marlin on all linears.
# NOTE: PREFILL_ATTN=int8 (int8-QK Triton attention) is bf16-KV ONLY -- the
# triton-prefill-attn-int8.patch falls through to FlashInfer under fp8 KV, so it
# is OFF at CTX=long and would buy nothing; INT8_ACT carries the prefill win.
INT8_ACT=int8
INT8_LAYERS=mlp|linear_attn|self_attn
# CTX=long (fp8 KV, FlashInfer). GPU_UTIL is a no-op for the pool: KV_MEM pins it
# by BYTES (vLLM: 'skipped memory profiling'), the REAL lever is KV_MEM (never above
# 5583457484, gotcha 39). VLLM_V2_CUDAGRAPH_MEM_MIB is an unknown env in 0.28 (no-op).
# Empirics with VBox 3D off (2026-09-14): at GPU_UTIL=0.93 the est. max len = 167232;
# MAX_LEN=167000 -> pool ~5.8GiB, real free at full pool ~0.8-1.0GiB (was 244MiB with
# VBoxHeadless stealing 472MiB). MAX_LEN=170000 needs 5.94GiB pool and OOM'd at 23MiB.
# If a VRAM thief ever returns, drop back to MAX_LEN=150000 (battery-proven).
DFLASH_MAX_LEN=170000
MAX_SEQS=1
KV_MEM=5583457484
VLLM_V2_CUDAGRAPH_MEM_MIB=800

#docker compose --profile single up -d --force-recreate

# model already prepared & verified; run the idempotent prepare/verify on each boot
PREPARE=1
VERIFY=1
VISION=0
TOOLS=1
GPU_UTIL=0.948
# Never let the engine fetch models from Hugging Face: our serving copy is the
# prepared -ar dir (MODEL above), NO_DOWNLOAD makes prepare fail loudly instead
# of downloading dbirks/...; FAST_VARIANT/DFLASH2=0 skip the optional fast-variant
# and DFlash2 drafter fetches we do not use.
NO_DOWNLOAD=1
FAST_VARIANT=0
DFLASH2=0