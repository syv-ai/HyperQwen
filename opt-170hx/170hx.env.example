# CMP 170HX (GA100, sm_80) decode tuning — 2026-11-07
# Merge these values into HyperQwen's .env. The real .env also holds
# VLLM_API_KEY and must never be committed.

CUDA_VISIBLE_DEVICES=0
GPU_COUNT=1

# DFlash2 speculative decoding, fastest single-user decode.
SPEC=dflash2
PREFIX_CACHE=1
CTX=fast

# 170HX: 163 KB smem/block fits a 64-token KV tile at D=256.
# Fixed 16 segments beats the adaptive path at C8 long context; adaptive
# leaves 44 of the 108 SMs idle there. MIN_BATCH=0 keeps split-KV at every
# batch, which is required for the single-stream long-context gain.
VLLM_SPEC_ATTN_NSEG=16
VLLM_SPEC_ATTN_MIN_BATCH=0

# The bind-mounted opt-170hx files differ from the patch series, and
# verify.sh matches patch lines, so skip verification while active.
VERIFY=0

# GA100 Xid-31 fixes (required on this card).
# Marlin repack on GA100 churns VMM mappings; the staged repack is the fix.
VLLM_MARLIN_REPACK_STAGED=1
# expandable_segments:True is an independent Xid-31 trigger on this card.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# 64 GiB card; keep the KV pool unpinned so vLLM sizes it from GPU_UTIL.
GPU_UTIL=0.90
KV_MEM=

# 262136 = 262144 - (num_speculative_tokens + 1) for DFlash2 k=7.
MAX_LEN=262136
MAX_SEQS=8

# Model location inside the container.
MODEL=/app/models/Qwen3.8-27B-W4A16-AutoRound

# CN hosts: huggingface.co is unreachable; use the mirror.
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1
